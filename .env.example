# Optional — only if you call OpenAI directly via process(). Prefer SERV Reasoning.
# OPENAI_API_KEY=

# === SERV Reasoning (required for compile_mandate / LLM) ===
# From https://console.openserv.ai → API Keys
# Used against https://inference-api.openserv.ai/v1
SERV_API_KEY=
# Optional model override (default gpt-5.4-mini)
# SERV_MODEL=gpt-5.4-mini

# Platform user key from https://platform.openserv.ai — only for cloud deploy of the agent host
# NOT the same as SERV_API_KEY / Reasoning
# OPENSERV_USER_API_KEY=

# Auto-filled by provision() when using Platform agent host
WALLET_PRIVATE_KEY=
OPENSERV_API_KEY=
OPENSERV_AUTH_TOKEN=
PORT=7378

# Coinbase AgentKit / CDP (for real Base transfers)
# https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# CDP_WALLET_ADDRESS=
NETWORK_ID=base-sepolia
# dry-run | live  (default: live if CDP_* set, else dry-run)
# SPENDGATE_EXECUTE_MODE=dry-run

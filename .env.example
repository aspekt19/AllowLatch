# Optional — only if you call OpenAI directly via process(). Prefer SERV Reasoning.
# OPENAI_API_KEY=

# === SERV Reasoning (required for compile_mandate / LLM) ===
# From https://console.openserv.ai → API Keys
# Used against https://inference-api.openserv.ai/v1
SERV_API_KEY=
# Optional model override (default gpt-5.4-mini; compile uses …-serv-multipath)
# SERV_MODEL=gpt-5.4-mini
# SERV_COMPILE_MODEL=gpt-5.4-mini-serv-multipath
# none | low | medium | high  (default low; compile forces medium)
# SERV_REASONING_EFFORT=low
# SERV_LOG=0  # silence [serv] usage lines

# Platform user key from https://platform.openserv.ai — only for cloud deploy of the agent host
# NOT the same as SERV_API_KEY / Reasoning
# OPENSERV_USER_API_KEY=

# Auto-filled by provision() when using Platform agent host
WALLET_PRIVATE_KEY=
OPENSERV_API_KEY=
OPENSERV_AUTH_TOKEN=
PORT=7378

# Coinbase AgentKit / CDP (for real Base transfers)
# https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# CDP_WALLET_ADDRESS=
# NETWORK_ID=base-sepolia
# dry-run | live  (default: live if CDP_* set, else dry-run)
# ALLOWLATCH_EXECUTE_MODE=dry-run
# BATTLE_DESTINATION_ADDRESS=

# Wallet-native Spend Permissions (optional but recommended)
# Owner smart account that grants a daily USDC allowance to the AgentKit spender wallet
# ALLOWLATCH_SMART_ACCOUNT=0x...
# middleware | hybrid | wallet_native  (default: hybrid if SMART_ACCOUNT set)
# ALLOWLATCH_ENFORCEMENT=hybrid
# ALLOWLATCH_RECEIPT_SECRET=   # HMAC secret for allow-receipts (falls back to SERV_API_KEY)
# Durable Vercel site gate (production). Unset = memory + sessionSeal demo.
# ALLOWLATCH_TURSO_DATABASE_URL=libsql://...
# ALLOWLATCH_TURSO_AUTH_TOKEN=
# ALLOWLATCH_PAYWALL_URL=      # OpenServ paywall for demo Enforce button

# HTTP gate (npm run http:gate) — bind loopback by default
# ALLOWLATCH_HTTP_HOST=127.0.0.1
# ALLOWLATCH_HTTP_PORT=8787
# ALLOWLATCH_HTTP_TOKEN=       # required if binding non-loopback; recommended locally
# ALLOWLATCH_DEV_PACKS=1       # allow local POST /v1/packs/grant|purchase (never public billing)
# ALLOWLATCH_COPILOT_ORIGINS=https://allowlatch.vercel.app,http://localhost:5173
# ALLOWLATCH_CORS_ORIGINS=     # alias for extra allowed Origins
# ALLOWLATCH_COPILOT_RATE_MAX=20
# ALLOWLATCH_SQLITE_PATH=      # override SQLite path (tests / multi-instance)

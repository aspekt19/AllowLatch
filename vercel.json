{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node scripts/vercel-ui-install.mjs",
  "buildCommand": "npx vite build",
  "outputDirectory": "web-dist",
  "functions": {
    "api/copilot.ts": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    },
    "api/host-info.ts": {
      "maxDuration": 10,
      "includeFiles": "src/web/**,src/http/abuse-guard.ts"
    },
    "api/gate.ts": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}

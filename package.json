{
  "name": "allowlatch",
  "version": "0.2.2",
  "description": "Spending turnstile for financial AI agents on Base/USDC \u2014 createGatedAgentKit({ kind: site }) + always-on /api/gate x402; SERV drafts; OpenServ optional",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assert-spend": {
      "types": "./dist/sdk/assert-spend.d.ts",
      "import": "./dist/sdk/assert-spend.js"
    },
    "./gated-agentkit": {
      "types": "./dist/sdk/gated-agentkit.d.ts",
      "import": "./dist/sdk/gated-agentkit.js"
    },
    "./action-provider": {
      "types": "./dist/sdk/allowlatch-action-provider.d.ts",
      "import": "./dist/sdk/allowlatch-action-provider.js"
    },
    "./schema": {
      "types": "./dist/policy/schema.d.ts",
      "import": "./dist/policy/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs/EMBED.md",
    "docs/CONNECT.md",
    "docs/SECURITY.md",
    "llms.txt",
    "agent.json",
    "bin",
    "docs/PITCH.md",
    "docs/GUIDE.md"
  ],
  "bin": {
    "allowlatch-mcp": "bin/allowlatch-mcp.mjs"
  },
  "scripts": {
    "dev": "tsx src/agent.ts",
    "demo": "tsx src/demo/run-demo.ts",
    "ui": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-isolation=process src/policy/engine.test.ts src/policy/engine.property.test.ts src/policy/local-compile.test.ts src/store/fs-store.test.ts src/auth/policy-eip712.test.ts src/web/site-gate.test.ts src/web/site-gate-durable.test.ts src/http/abuse-guard.test.ts",
    "mcp": "tsx src/mcp/server.ts",
    "reasoning:ping": "tsx src/demo/reasoning-ping.ts",
    "reasoning:compile": "tsx src/demo/reasoning-compile.ts",
    "reasoning:cycle": "tsx src/demo/reasoning-cycle.ts",
    "reasoning:draft": "tsx src/demo/reasoning-draft.ts",
    "reasoning:copilot": "tsx src/demo/reasoning-copilot.ts",
    "battle": "tsx src/spender/battle.ts",
    "wow": "tsx src/demo/wow.ts",
    "gate:policy": "tsx examples/gate-with-policy.ts",
    "assert:spend": "tsx examples/assert-spend-demo.ts",
    "agent:gated": "tsx examples/create-gated-agent.ts",
    "bypass:negative": "tsx examples/bypass-negative.ts",
    "connect": "tsx examples/connect-as-agent.ts",
    "owner:copilot": "tsx examples/owner-copilot.ts",
    "http:gate": "tsx src/http/gate-server.ts",
    "deploy:openserv": "npx @openserv-labs/client deploy .",
    "deploy:host": "node scripts/deploy-openserv-host.mjs"
  },
  "keywords": [
    "allowlatch",
    "agentkit",
    "x402",
    "base",
    "usdc",
    "mcp",
    "openserv"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/cdp-sdk": "^1.56.0",
    "@coinbase/x402": "^0.6.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openserv-labs/client": "^2.5.3",
    "@openserv-labs/sdk": "^2.4.1",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "openai": "^7.15.0",
    "viem": "^2.56.5",
    "x402": "^0.6.6",
    "x402-fetch": "^0.6.6",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@vercel/node": "^13.0.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspekt19/AllowLatch.git"
  },
  "homepage": "https://allowlatch.vercel.app",
  "bugs": {
    "url": "https://github.com/aspekt19/AllowLatch/issues"
  }
}
